# 로컬 개발 환경변수 템플릿.
# 사용법: 이 파일을 `.env.local` 로 복사한 뒤 값을 채운다. `.env.local` 은 git 무시 대상이다.

# ---------------------------------------------------------------
# 실서버 스위치
# ---------------------------------------------------------------
# true  → POST /api/public/v1/emergency-access 를 실제로 호출한다.
#          응답(FHIR records[])은 src/api/backendAdapter.ts 가 화면 형태로 변환한다.
#          브라우저는 same-origin 상대경로만 쓰므로 dev 는 Vite proxy,
#          prod 는 netlify.toml redirect 가 백엔드로 forward 한다.
# false → src/api/emergencyAccess.ts 의 mock 페르소나를 사용한다 (기본값).
#
# 실 백엔드 연동 시 수동코드는 숫자 10자리, QR 티켓은 base64url 40~100자다.
# 데모 코드(M3D1-7K9Q)는 mock 모드에서만 동작한다.
VITE_USE_REAL_BACKEND=false

# ---------------------------------------------------------------
# DEV proxy 타깃
# ---------------------------------------------------------------
# Vite dev server 가 `/api`, `/demo`, `/.well-known` 요청을 forward 할 Backend origin.
# EC2 공인 IP 기반 sslip.io 주소는 IP 변동 시 바뀔 수 있으므로 여기서 관리한다.
# 값이 없으면 vite.config.ts 의 기본값이 사용된다.
VITE_API_PROXY_TARGET=https://api-175-45-193-221.sslip.io
