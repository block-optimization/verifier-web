# 로컬 개발 환경변수 템플릿.
# 사용법: 이 파일을 `.env.local` 로 복사한 뒤 값을 채운다. `.env.local` 은 git 무시 대상이다.

# ---------------------------------------------------------------
# DEV proxy 타깃
# ---------------------------------------------------------------
# verifier-web은 백엔드의 공용(비개인화) 리버스지오코딩 엔드포인트 하나만 호출한다
# (/api/public/v1/location/reverse-geocode, src/api/location.ts). 공개 조회/카드별
# 발급 API는 더 이상 쓰지 않는다 — 발견자는 전부 같은 공용 링크로 들어온다.
# Vite dev server 가 그 경로를 forward 할 Backend origin.
# EC2 공인 IP 기반 sslip.io 주소는 IP 변동 시 바뀔 수 있으므로 여기서 관리한다.
# 값이 없으면 vite.config.ts 의 기본값이 사용된다.
VITE_API_PROXY_TARGET=https://api-175-45-193-221.sslip.io

# ---------------------------------------------------------------
# Naver Maps — 위치 지도 토글 + 역지오코딩(좌표→주소)
# ---------------------------------------------------------------
# 클라이언트 지도 SDK 로드용 Client ID. 프론트 번들에 포함되어도 안전하다 —
# Naver Cloud Platform 콘솔에 등록한 서비스 URL(도메인)로만 접근이 제한된다.
# 값이 비어 있으면 위치 카드의 "지도로 보기" 토글이 비활성으로 표시된다.
VITE_NAVER_MAPS_CLIENT_ID=

# 좌표 → 주소 변환(역지오코딩)에 쓰는 Client Secret 은 이 저장소에 두지 않는다.
# 백엔드의 POST /api/public/v1/location/reverse-geocode 가 서버에서 대신 호출하며,
# 프론트·Netlify 어느 쪽에도 비밀키 사본을 두지 않는다 (FE 수정요청서 2026-09-20).
